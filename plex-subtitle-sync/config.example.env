# Copy to config.env and fill in. Keep config.env private (it holds your token).
#   cp config.example.env config.env && nano config.env

# --- Required ---------------------------------------------------------------
# Plex base URL. On the NAS itself this is usually http://localhost:32400
PLEX_BASEURL=http://192.168.0.46:32400
# Your Plex token. Find it: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=changeme

# --- Shows / library --------------------------------------------------------
# Values with spaces/parentheses must be quoted: this file is sourced by the
# shell ( . ./config.env ) as well as read by systemd's EnvironmentFile.
PLEX_TV_SECTION="TV Shows"
SHOWS="Matlock,High Potential,Saturday Night Live (UK)"
SUB_LANGUAGE=en

# --- Optional: OpenSubtitles (raises download limits for missing subtitles) -
OS_USERNAME=
OS_PASSWORD=

# --- Behaviour --------------------------------------------------------------
# Path to the small JSON file tracking what's already been synced.
STATE_FILE=/var/lib/plex-subtitle-sync/state.json
# Set to 1 to re-sync everything regardless of state.
FORCE_RESYNC=0
# Set to 1 to log actions without changing any files.
DRY_RUN=0
